---
import '../styles/globals.css';
import Header from '../components/layout/Header.astro';
import Sidebar from '../components/layout/Sidebar.astro';
import Footer from '../components/layout/Footer.astro';
import CommandPalette from '../components/search/CommandPalette';

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  canonical?: string;
}

const {
  title,
  description = 'DevVault — El hub definitivo de productividad para desarrolladores. CLI tools, configs, scripts, y más.',
  ogImage = '/og-image.png',
  canonical,
} = Astro.props;

const siteUrl = 'https://devvault.dev';
const canonicalUrl = canonical ?? new URL(Astro.url.pathname, siteUrl).href;
---

<!doctype html>
<html lang="es" class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{title} | DevVault</title>

    <!-- Canonical -->
    <link rel="canonical" href={canonicalUrl} />

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!-- OpenGraph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={`${title} | DevVault`} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={`${siteUrl}${ogImage}`} />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={`${title} | DevVault`} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={`${siteUrl}${ogImage}`} />

    <!-- JSON-LD -->
    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'WebSite',
      name: 'DevVault',
      url: siteUrl,
      description: 'El hub definitivo de productividad para desarrolladores',
    })} />
  </head>
  <body class="min-h-screen bg-base text-text">
    <!-- Skip to content -->
    <a href="#main-content" class="sr-only focus:not-sr-only focus:absolute focus:top-4 focus:left-4 bg-blue text-crust px-4 py-2 rounded-lg z-50 font-semibold">
      Saltar al contenido
    </a>

    <div class="flex min-h-screen">
      <!-- Sidebar (desktop) -->
      <Sidebar />

      <!-- Main area -->
      <div class="flex-1 flex flex-col min-w-0 lg:ml-[240px]">
        <Header />
        <main id="main-content" class="flex-1 p-4 md:p-6 lg:p-8 max-w-content mx-auto w-full">
          <slot />
        </main>
        <Footer />
      </div>
    </div>

    <!-- Command Palette (React island) -->
    <CommandPalette client:load />
  </body>
</html>
