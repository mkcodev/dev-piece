---
import '@fontsource-variable/onest/wght.css';
import '@fontsource-variable/jetbrains-mono/wght.css';
import onestLatin from '@fontsource-variable/onest/files/onest-latin-wght-normal.woff2?url';
import '../styles/globals.css';
import '../styles/transitions.css';
import '../styles/nav.css';
import Header from '../components/layout/Header.astro';
import Sidebar from '../components/layout/Sidebar.astro';
import Footer from '../components/layout/Footer.astro';
import CommandPalette from '../components/search/CommandPalette';
import TransitionController from '../components/layout/TransitionController.astro';
import { ClientRouter } from 'astro:transitions';

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  canonical?: string;
}

const {
  title,
  description = 'DevPiece — El hub definitivo de productividad para desarrolladores. CLI tools, configs, scripts, y más.',
  ogImage = '/og-image.png',
  canonical,
} = Astro.props;

const siteUrl = 'https://devpiece.vercel.app';
const canonicalUrl = canonical ?? new URL(Astro.url.pathname, siteUrl).href;
---

<!doctype html>
<html lang="es" class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{title} | DevPiece</title>

    <!-- Canonical -->
    <link rel="canonical" href={canonicalUrl} />
    <!-- Self-hosted UI font: preload the latin subset used above the fold -->
    <link rel="preload" href={onestLatin} as="font" type="font/woff2" crossorigin />


    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!-- OpenGraph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={`${title} | DevPiece`} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={`${siteUrl}${ogImage}`} />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={`${title} | DevPiece`} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={`${siteUrl}${ogImage}`} />

    <!-- View Transitions (Astro 6 ClientRouter) -->
    <ClientRouter />

    <!-- JSON-LD -->
    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'WebSite',
      name: 'DevPiece',
      url: siteUrl,
      description: 'El hub definitivo de productividad para desarrolladores',
    })} />

    <!-- Sidebar rail state before first paint; re-applied after each swap because
         the router replaces <html> attributes on navigation -->
    <script is:inline>
      (() => {
        const apply = () => {
          try {
            if (localStorage.getItem('devpiece-sidebar-collapsed') === '1') document.documentElement.dataset.sidebar = 'rail';
          } catch {}
        };
        apply();
        if (!window.__dpRail) {
          window.__dpRail = true;
          document.addEventListener('astro:after-swap', apply);
        }
      })();
    </script>

    <!-- Migrate localStorage keys from the old DevVault name (runs before islands hydrate) -->
    <script is:inline>
      try {
        for (const oldKey of Object.keys(localStorage)) {
          if (!oldKey.startsWith('devvault-')) continue;
          const newKey = 'devpiece-' + oldKey.slice('devvault-'.length);
          if (localStorage.getItem(newKey) === null) {
            localStorage.setItem(newKey, localStorage.getItem(oldKey));
          }
          localStorage.removeItem(oldKey);
        }
      } catch {}
    </script>
  </head>
  <body class="min-h-screen bg-base text-text">
    <!-- Transition manager + progress bar -->
    <TransitionController />

    <!-- Skip to content -->
    <a href="#main-content" class="sr-only focus:not-sr-only focus:absolute focus:top-4 focus:left-4 bg-blue text-crust px-4 py-2 rounded-lg z-50 font-semibold">
      Saltar al contenido
    </a>

    <div class="flex min-h-screen">
      <!-- Sidebar persists across navigations (no re-render flash) -->
      <Sidebar transition:persist="sidebar" />

      <!-- Main area -->
      <div class="flex-1 flex flex-col min-w-0 lg:ml-[var(--sidebar-w)]">
        <!-- Header persists too -->
        <Header transition:persist="header" />

        <!-- Main content — named for view transitions -->
        <main
          id="main-content"
          class="flex-1 p-4 md:p-6 lg:p-8 max-w-content mx-auto w-full"
          transition:name="page-main"
          transition:animate="none"
        >
          <slot />
        </main>
        <Footer />
      </div>
    </div>

    <!-- Command Palette (React island) -->
    <CommandPalette client:load />
  </body>
</html>
