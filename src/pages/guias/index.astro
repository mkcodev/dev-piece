---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const guides = await getCollection('guias');

// Sort: newest first (by addedAt)
const sorted = [...guides].sort((a, b) => {
  const da = new Date(a.data.addedAt ?? 0).getTime();
  const db = new Date(b.data.addedAt ?? 0).getTime();
  return db - da;
});

const difficultyConfig: Record<string, { label: string; color: string }> = {
  beginner:     { label: 'Principiante', color: 'text-green  bg-green/10  border-green/30'  },
  intermediate: { label: 'Intermedio',   color: 'text-yellow bg-yellow/10 border-yellow/30' },
  advanced:     { label: 'Avanzado',     color: 'text-red    bg-red/10    border-red/30'    },
};

const osBadgeConfig: Record<string, { label: string; color: string }> = {
  windows: { label: 'Windows', color: 'bg-blue/20   text-blue   border-blue/30'   },
  macos:   { label: 'macOS',   color: 'bg-mauve/20  text-mauve  border-mauve/30'  },
  linux:   { label: 'Linux',   color: 'bg-peach/20  text-peach  border-peach/30'  },
};
---

<BaseLayout
  title="Guías"
  description="Guías paso a paso para desarrolladores. De cero a un setup productivo en cada área: terminal, editor, Git, IA y más."
>
  <!-- Page header -->
  <div class="mb-10">
    <nav class="flex items-center gap-2 text-sm text-subtext1 mb-6" aria-label="Ruta de navegación">
      <a href="/" class="hover:text-text transition-colors">Inicio</a>
      <span aria-hidden="true">/</span>
      <span class="text-text font-medium" aria-current="page">Guías</span>
    </nav>

    <div class="relative text-center py-10">
      <div class="absolute inset-0 overflow-hidden pointer-events-none" aria-hidden="true">
        <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[500px] h-[200px] bg-gradient-to-r from-teal/10 via-green/10 to-sapphire/10 blur-3xl rounded-full" />
      </div>
      <div class="relative">
        <div class="inline-flex items-center gap-2 bg-surface0 border border-surface1 rounded-full px-4 py-1.5 text-xs text-subtext1 mb-5">
          <span class="w-1.5 h-1.5 rounded-full bg-teal animate-pulse" aria-hidden="true" />
          Guías paso a paso
        </div>
        <h1 class="text-4xl md:text-6xl font-black mb-4 leading-tight">
          <span class="text-lavender">Guías</span>
          <br />
          <span class="text-text text-3xl md:text-4xl font-bold">para Devs</span>
        </h1>
        <p class="text-base md:text-lg text-subtext1 max-w-2xl mx-auto leading-relaxed">
          De cero a un setup productivo, con instrucciones detalladas, comandos listos para copiar
          y seguimiento de tu progreso paso a paso.
        </p>
      </div>
    </div>
  </div>

  <!-- Filters -->
  <div class="flex flex-wrap items-center gap-2 mb-8" id="guide-filters">
    <!-- OS filters -->
    <button type="button" data-filter="os" data-value="all"
      class="filter-btn active text-xs px-3 py-1.5 rounded-full border border-surface1 bg-surface0 text-subtext1 hover:text-text hover:border-overlay0 transition-all"
      aria-pressed="true"
    >Todos</button>
    <button type="button" data-filter="os" data-value="windows"
      class="filter-btn text-xs px-3 py-1.5 rounded-full border border-surface1 bg-surface0 text-subtext1 hover:text-text hover:border-overlay0 transition-all"
      aria-pressed="false"
    >Windows</button>
    <button type="button" data-filter="os" data-value="macos"
      class="filter-btn text-xs px-3 py-1.5 rounded-full border border-surface1 bg-surface0 text-subtext1 hover:text-text hover:border-overlay0 transition-all"
      aria-pressed="false"
    >macOS</button>
    <button type="button" data-filter="os" data-value="linux"
      class="filter-btn text-xs px-3 py-1.5 rounded-full border border-surface1 bg-surface0 text-subtext1 hover:text-text hover:border-overlay0 transition-all"
      aria-pressed="false"
    >Linux</button>

    <div class="w-px h-5 bg-surface1 mx-1" aria-hidden="true" />

    <!-- Difficulty filters -->
    <button type="button" data-filter="diff" data-value="all"
      class="filter-btn-diff active text-xs px-3 py-1.5 rounded-full border border-surface1 bg-surface0 text-subtext1 hover:text-text hover:border-overlay0 transition-all"
      aria-pressed="true"
    >Todas dificultades</button>
    <button type="button" data-filter="diff" data-value="beginner"
      class="filter-btn-diff text-xs px-3 py-1.5 rounded-full border border-green/30 chip chip-green hover:bg-green/20 transition-all"
      aria-pressed="false"
    >Principiante</button>
    <button type="button" data-filter="diff" data-value="intermediate"
      class="filter-btn-diff text-xs px-3 py-1.5 rounded-full border border-yellow/30 chip chip-yellow hover:bg-yellow/20 transition-all"
      aria-pressed="false"
    >Intermedio</button>
    <button type="button" data-filter="diff" data-value="advanced"
      class="filter-btn-diff text-xs px-3 py-1.5 rounded-full border border-red/30 chip chip-red hover:bg-red/20 transition-all"
      aria-pressed="false"
    >Avanzado</button>

    <div class="ml-auto text-xs text-subtext1" id="guide-count" aria-live="polite">
      {sorted.length} guía{sorted.length !== 1 ? 's' : ''}
    </div>
  </div>

  <!-- Guide grid -->
  <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-5" id="guide-grid" role="list">
    {sorted.map((guide, i) => {
      const data = guide.data;
      const diffCfg = difficultyConfig[data.difficulty] ?? { label: data.difficulty, color: 'text-subtext1 bg-surface0 border-surface1' };
      const slug = data.slug ?? guide.id;
      return (
        <a
          href={`/guias/${slug}`}
          class="guide-card tool-card group block bg-surface0 border border-surface1 rounded-xl p-5 no-underline relative overflow-hidden stagger-in"
          style={`--i: ${i};`}
          data-os={JSON.stringify(data.os ?? [])}
          data-difficulty={data.difficulty ?? ''}
          role="listitem"
          aria-label={`Guía: ${data.name}`}
        >
          <!-- Top row: difficulty + time -->
          <div class="flex items-center justify-between mb-3">
            <span class={`text-xs px-2.5 py-1 rounded-full border font-medium ${diffCfg.color}`}>
              {diffCfg.label}
            </span>
            <span class="flex items-center gap-1 text-xs text-subtext1">
              <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <circle cx="12" cy="12" r="10"/><path d="M12 8v4l3 3"/>
              </svg>
              {data.estimatedTime}
            </span>
          </div>

          <!-- Title + description -->
          <h2 class="text-base font-bold text-text mb-2 group-hover:text-lavender transition-colors leading-tight line-clamp-2">
            {data.name}
          </h2>
          <p class="text-sm text-subtext1 leading-relaxed line-clamp-3 mb-4">
            {data.description}
          </p>

          <!-- Footer: OS badges + completedBy -->
          <div class="flex items-center justify-between gap-2 mt-auto">
            <div class="flex flex-wrap items-center gap-1">
              {(data.os).map((os) => {
                const cfg = osBadgeConfig[os];
                return cfg ? (
                  <span class={`text-xs px-2 py-0.5 rounded-full border font-medium ${cfg.color}`}>
                    {cfg.label}
                  </span>
                ) : null;
              })}
            </div>
            <span class="flex items-center gap-1 text-xs text-subtext1 flex-shrink-0">
              <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4M7.835 4.697a3.42 3.42 0 001.946-.806 3.42 3.42 0 014.438 0 3.42 3.42 0 001.946.806 3.42 3.42 0 013.138 3.138 3.42 3.42 0 00.806 1.946 3.42 3.42 0 010 4.438 3.42 3.42 0 00-.806 1.946 3.42 3.42 0 01-3.138 3.138 3.42 3.42 0 00-1.946.806 3.42 3.42 0 01-4.438 0 3.42 3.42 0 00-1.946-.806 3.42 3.42 0 01-3.138-3.138 3.42 3.42 0 00-.806-1.946 3.42 3.42 0 010-4.438 3.42 3.42 0 00.806-1.946 3.42 3.42 0 013.138-3.138z"/>
              </svg>
              {(data.completedByCount ?? 0).toLocaleString('es-ES')} completaron
            </span>
          </div>

          <!-- Tags -->
          {data.tags && data.tags.length > 0 && (
            <div class="flex flex-wrap gap-1 mt-3 pt-3 border-t border-surface1">
              {data.tags.slice(0, 4).map((tag) => (
                <span class="text-xs px-1.5 py-0.5 rounded bg-surface1 text-subtext1">#{tag}</span>
              ))}
              {data.tags.length > 4 && (
                <span class="text-xs px-1.5 py-0.5 rounded bg-surface1 text-subtext1">+{data.tags.length - 4}</span>
              )}
            </div>
          )}
        </a>
      );
    })}
  </div>

  <!-- Empty state -->
  <div id="guide-empty" class="hidden py-20 text-center text-subtext1" aria-live="polite">
    <p class="text-lg mb-2">No hay guías para esa combinación de filtros</p>
    <p class="text-sm">Prueba quitando algún filtro</p>
  </div>

  <!-- Info footer -->
  <div class="mt-12 p-5 bg-mantle border border-surface1 rounded-xl flex flex-col sm:flex-row items-start sm:items-center gap-4">
    <div class="text-2xl flex-shrink-0" aria-hidden="true">📖</div>
    <div>
      <p class="text-sm text-subtext1 leading-relaxed">
        Las guías son <strong class="text-text">interactivas</strong>: marca cada paso como completado,
        usa la <strong class="text-text">Guía Rápida</strong> para copiar solo los comandos, y completa
        la guía para añadir automáticamente todas las herramientas a tu arsenal.
      </p>
    </div>
  </div>
</BaseLayout>

<script>
  let activeOS   = 'all';
  let activeDiff = 'all';

  const cards    = document.querySelectorAll<HTMLElement>('.guide-card');
  const empty    = document.getElementById('guide-empty');
  const countEl  = document.getElementById('guide-count');

  function applyFilters() {
    let visible = 0;
    cards.forEach(card => {
      const os: string[]  = JSON.parse(card.dataset.os ?? '[]');
      const diff: string  = card.dataset.difficulty ?? '';
      const osOk   = activeOS   === 'all' || os.includes(activeOS);
      const diffOk = activeDiff === 'all' || diff === activeDiff;
      const show   = osOk && diffOk;
      card.style.display = show ? '' : 'none';
      if (show) visible++;
    });
    if (empty) empty.classList.toggle('hidden', visible > 0);
    if (countEl) countEl.textContent = `${visible} guía${visible !== 1 ? 's' : ''}`;
  }

  // OS filter buttons
  document.querySelectorAll<HTMLButtonElement>('[data-filter="os"]').forEach(btn => {
    btn.addEventListener('click', () => {
      activeOS = btn.dataset.value ?? 'all';
      document.querySelectorAll('[data-filter="os"]').forEach(b => {
        b.classList.toggle('active', b === btn);
        (b as HTMLElement).setAttribute('aria-pressed', String(b === btn));
      });
      applyFilters();
    });
  });

  // Difficulty filter buttons
  document.querySelectorAll<HTMLButtonElement>('[data-filter="diff"]').forEach(btn => {
    btn.addEventListener('click', () => {
      activeDiff = btn.dataset.value ?? 'all';
      document.querySelectorAll('[data-filter="diff"]').forEach(b => {
        b.classList.toggle('active', b === btn);
        (b as HTMLElement).setAttribute('aria-pressed', String(b === btn));
      });
      applyFilters();
    });
  });
</script>

<style>
  .filter-btn.active,
  .filter-btn-diff.active {
    background-color: rgb(var(--color-surface1));
    color: rgb(var(--color-text));
    border-color: rgb(var(--color-overlay1));
  }
</style>
