---
import BaseLayout from '../layouts/BaseLayout.astro';
import ToolCard from '../components/tools/ToolCard.astro';
import ArsenalBentoWidget from '../components/arsenal/ArsenalBentoWidget';
import { getFeaturedTools, getRecentTools, getAllTools } from '../lib/content';
import { CATEGORY_CONFIG } from '../lib/utils';
import { getCollection } from 'astro:content';

const featuredTools = await getFeaturedTools();
const recentTools = await getRecentTools(6);
const allTools = await getAllTools();

// Category counts
const categoryCounts: Record<string, number> = {};
for (const cat of Object.keys(CATEGORY_CONFIG)) {
  try {
    const entries = await getCollection(cat as any);
    categoryCounts[cat] = entries.length;
  } catch {
    categoryCounts[cat] = 0;
  }
}

const totalTools = allTools.length;
const totalCategories = Object.keys(CATEGORY_CONFIG).length;
const totalScripts = (categoryCounts['scripts-ahk'] ?? 0) + (categoryCounts['userscripts'] ?? 0) + (categoryCounts['snippets'] ?? 0);

// Curated featured categories for the horizontal scroll
const FEATURED_CATEGORIES = [
  { slug: 'vscode', label: 'VS Code', description: 'Extensiones y settings', icon: 'visualstudiocode', accent: '#8caaee' },
  { slug: 'browser-extensions', label: 'Chrome Extensions', description: 'Power tools para el navegador', icon: 'googlechrome', accent: '#e5c890' },
  { slug: 'ai-tools', label: 'IA para Devs', description: 'Claude Code, Copilot y más', icon: 'anthropic', accent: '#babbf1' },
  { slug: 'cli-tools', label: 'CLI Tools', description: 'Reemplazos modernos de comandos', icon: 'gnubash', accent: '#a6d189' },
  { slug: 'terminales', label: 'Terminales', description: 'Alacritty, Ghostty, Warp...', icon: 'windowsterminal', accent: '#8caaee' },
  { slug: 'git-hacks', label: 'Git Power Moves', description: 'Técnicas avanzadas de Git', icon: 'git', accent: '#ef9f76' },
  { slug: 'docker', label: 'Docker Hacks', description: 'Comandos y trucos Docker', icon: 'docker', accent: '#85c1dc' },
  { slug: 'neovim', label: 'Neovim', description: 'Plugins y configuraciones', icon: 'neovim', accent: '#a6d189' },
];

const categoryAccents: Record<string, string> = {
  terminales: '#8caaee',
  'cli-tools': '#a6d189',
  snippets: '#ef9f76',
  neovim: '#a6d189',
  vscode: '#8caaee',
  'browser-extensions': '#e5c890',
  'scripts-ahk': '#ca9ee6',
  userscripts: '#81c8be',
  dotfiles: '#babbf1',
  docker: '#85c1dc',
  'git-hacks': '#ef9f76',
  fonts: '#f4b8e4',
  'ai-tools': '#babbf1',
  'windows-tools': '#99d1db',
  learning: '#a6d189',
  'web-resources': '#81c8be',
};
---

<BaseLayout title="Inicio" description="DevPiece — El hub definitivo de productividad para desarrolladores. CLI tools, configs, scripts, y más.">

  <!-- Hero -->
  <section class="relative text-center py-16 md:py-24 mb-16">
    <div class="absolute inset-0 overflow-hidden pointer-events-none" aria-hidden="true">
      <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[600px] h-[300px] bg-gradient-to-r from-blue/10 via-lavender/10 to-mauve/10 blur-3xl rounded-full" />
    </div>

    <div class="relative">
      <div class="inline-flex items-center gap-2 bg-surface0 border border-surface1 rounded-full px-4 py-1.5 text-xs text-subtext1 mb-6">
        <span class="w-1.5 h-1.5 rounded-full bg-green animate-pulse" aria-hidden="true" />
        Open source &amp; siempre gratis
      </div>

      <h1 class="text-display font-extrabold mb-5">
        Dev<span class="text-lavender">Piece</span>
      </h1>

      <p class="text-lg md:text-xl text-subtext1 mb-4 max-w-2xl mx-auto leading-relaxed">
        Tu arsenal definitivo de productividad como desarrollador.
        Herramientas CLI, configuraciones, scripts y trucos curados para el
        <span class="text-lavender font-semibold">flujo de trabajo</span> perfecto.
      </p>

      <div class="inline-flex items-center bg-crust border border-surface0 rounded-lg px-4 py-2.5 mb-8 font-mono text-sm">
        <span class="text-green mr-2" aria-hidden="true">$</span>
        <span id="typewriter" class="text-sky" aria-label="Ejemplo de comando CLI">winget install sharkdp.bat</span>
        <span class="w-0.5 h-4 bg-text ml-0.5 animate-pulse" aria-hidden="true" />
      </div>

      <div class="flex flex-wrap items-center justify-center gap-6 mb-8 text-sm text-subtext1">
        <div class="flex items-center gap-1.5">
          <span class="font-bold text-text text-base">{totalTools}</span>
          herramientas
        </div>
        <span class="text-surface2" aria-hidden="true">·</span>
        <div class="flex items-center gap-1.5">
          <span class="font-bold text-text text-base">{totalCategories}</span>
          categorías
        </div>
        <span class="text-surface2" aria-hidden="true">·</span>
        <div class="flex items-center gap-1.5">
          <span class="font-bold text-text text-base">{totalScripts}</span>
          scripts
        </div>
      </div>

      <div class="flex flex-wrap items-center justify-center gap-3">
        <button
          id="hero-search-btn"
          class="flex items-center gap-2 bg-blue hover:bg-lavender text-crust font-semibold px-6 py-2.5 rounded-lg transition-colors duration-200"
         
        >
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <circle cx="11" cy="11" r="8"/>
            <line x1="21" y1="21" x2="16.65" y2="16.65"/>
          </svg>
          Buscar herramientas
          <kbd class="text-xs border border-crust/40 px-1.5 py-0.5 rounded font-mono">⌘K</kbd>
        </button>
        <a
          href="/cli-tools"
          class="flex items-center gap-2 bg-surface0 hover:bg-surface1 text-text border border-surface1 font-medium px-6 py-2.5 rounded-lg transition-colors duration-200"
        >
          Explorar CLI Tools
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m9 18 6-6-6-6"/>
          </svg>
        </a>
      </div>
    </div>
  </section>

  <!-- BentoGrid Stats -->
  <section class="mb-16 stagger-in" style="--i: 0" aria-label="Estadísticas de DevPiece">
    <div class="grid grid-cols-2 lg:grid-cols-4 gap-3">
      <!-- Big stat: Total tools -->
      <div class="col-span-2 relative overflow-hidden bg-gradient-to-br from-blue/20 via-lavender/10 to-surface0 border border-blue/20 rounded-2xl p-6 flex flex-col justify-between min-h-[120px]">
        <div class="absolute top-0 right-0 w-32 h-32 bg-gradient-to-bl from-blue/20 to-transparent rounded-full -translate-y-8 translate-x-8 pointer-events-none" aria-hidden="true" />
        <div>
          <p class="text-xs font-semibold text-blue uppercase tracking-wider mb-1">Arsenal completo</p>
          <p class="text-5xl font-black text-text">{totalTools}</p>
        </div>
        <p class="text-sm text-subtext1">herramientas curadas para tu workflow</p>
      </div>

      <!-- Categories stat -->
      <div class="relative overflow-hidden bg-surface0 border border-surface1 rounded-2xl p-5 flex flex-col justify-between min-h-[120px]">
        <div>
          <p class="text-xs text-subtext1 mb-2 uppercase tracking-wider">Categorías</p>
          <p class="text-4xl font-black text-lavender">{totalCategories}</p>
        </div>
        <p class="text-xs text-subtext1">áreas cubiertas</p>
      </div>

      <!-- Scripts stat -->
      <div class="relative overflow-hidden bg-surface0 border border-surface1 rounded-2xl p-5 flex flex-col justify-between min-h-[120px]">
        <div>
          <p class="text-xs text-subtext1 mb-2 uppercase tracking-wider">Scripts</p>
          <p class="text-4xl font-black text-peach">{totalScripts}</p>
        </div>
        <p class="text-xs text-subtext1">alias & automatizaciones</p>
      </div>

      <!-- Roadmaps CTA -->
      <a
        href="/roadmaps"
        class="col-span-2 group relative overflow-hidden bg-gradient-to-br from-mauve/20 via-pink/10 to-surface0 border border-mauve/20 hover:border-mauve/40 rounded-2xl p-5 flex items-center gap-4 transition-all duration-200"
      >
        <div class="w-12 h-12 rounded-xl bg-mauve/20 flex items-center justify-center flex-shrink-0 text-2xl">🗺️</div>
        <div class="min-w-0 flex-1">
          <p class="font-bold text-text text-sm">Roadmaps interactivos</p>
          <p class="text-xs text-subtext1 mt-0.5">5 rutas de aprendizaje — Tech y Tools</p>
        </div>
        <svg class="w-4 h-4 text-subtext1 group-hover:text-mauve transition-colors flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m9 18 6-6-6-6"/>
        </svg>
      </a>

      <!-- OS coverage -->
      <div class="col-span-2 bg-surface0 border border-surface1 rounded-2xl p-5 flex items-center gap-4">
        <div class="flex gap-2 flex-shrink-0">
          <span class="text-xs px-2 py-1 rounded border font-mono chip chip-blue">Win</span>
          <span class="text-xs px-2 py-1 rounded border font-mono chip chip-mauve">Mac</span>
          <span class="text-xs px-2 py-1 rounded border font-mono chip chip-peach">Linux</span>
          <span class="text-xs px-2 py-1 rounded border font-mono chip chip-green">Cross</span>
        </div>
        <p class="text-xs text-subtext1">Herramientas etiquetadas por sistema operativo</p>
      </div>
    </div>
  </section>

  <!-- Featured Categories (horizontal scroll) -->
  <section class="mb-16 stagger-in" style="--i: 1" aria-labelledby="featured-cats-heading">
    <div class="flex items-center justify-between mb-5">
      <h2 id="featured-cats-heading" class="text-xl font-bold text-text">Categorías Destacadas</h2>
      <span class="text-xs text-subtext1">Desliza →</span>
    </div>
    <div id="feat-cats-scroll" class="flex gap-3 overflow-x-auto pt-4 pb-5 -mx-4 px-4 md:-mx-6 md:px-6 snap-x snap-mandatory [&::-webkit-scrollbar]:hidden [scrollbar-width:none] select-none" style="cursor:grab">
      {FEATURED_CATEGORIES.map((cat) => (
        <a
          href={`/${cat.slug}`}
          data-cat-slug={cat.slug}
          class="flex-shrink-0 snap-start group flex flex-col items-center gap-3 p-5 bg-surface0 hover:bg-surface1 border border-surface1 hover:border-lavender/40 rounded-2xl transition-all duration-200 w-[140px] tool-card"
          style={`--card-accent: ${cat.accent};`}
        >
          <div
            class="cat-icon-el card-icon-wrap w-12 h-12 rounded-xl flex items-center justify-center overflow-hidden"
            style={`background-color: ${cat.accent}20;`}
            aria-hidden="true"
          >
            <img
              src={`https://cdn.simpleicons.org/${cat.icon}`}
              alt=""
              width="28"
              height="28"
              class="w-7 h-7 object-contain featured-cat-icon"
              data-fallback={cat.label.charAt(0)}
              data-accent={cat.accent}
            />
          </div>
          <div class="text-center">
            <p class="text-xs font-semibold text-text leading-tight">{cat.label}</p>
            <p class="text-xs text-subtext1 mt-0.5 leading-tight">{cat.description}</p>
          </div>
          <span
            class="text-xs font-mono px-2 py-0.5 rounded-full"
            style={`background-color: ${cat.accent}20; color: ${cat.accent};`}
          >
            {categoryCounts[cat.slug] ?? 0}
          </span>
        </a>
      ))}
    </div>
  </section>

  <!-- Arsenal Bento Widget -->
  <ArsenalBentoWidget client:load />

  <!-- Featured Tools -->
  {featuredTools.length > 0 && (
    <section class="mb-16 stagger-in" style="--i: 2" aria-labelledby="featured-heading">
      <div class="flex items-center justify-between mb-6">
        <h2 id="featured-heading" class="text-xl font-bold text-text flex items-center gap-2">
          <span class="text-yellow" aria-hidden="true">★</span>
          Herramientas Destacadas
        </h2>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-4">
        {featuredTools.slice(0, 6).map((tool) => (
          <ToolCard
            name={tool.data.name}
            description={tool.data.description}
            tags={tool.data.tags}
            os={tool.data.os}
            category={tool.collectionName}
            slug={tool.slug}
            featured={tool.data.featured}
            difficulty={tool.data.difficulty}
            install={tool.data.install}
            accent={categoryAccents[tool.collectionName] ?? '#8caaee'}
          />
        ))}
      </div>
    </section>
  )}

  <!-- Category Grid -->
  <section class="mb-16 stagger-in" style="--i: 3" aria-labelledby="categories-heading">
    <h2 id="categories-heading" class="text-xl font-bold text-text mb-6">
      Explorar por Categoría
    </h2>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-3">
      {Object.entries(CATEGORY_CONFIG).map(([slug, config]) => (
        <a
          href={`/${slug}`}
          data-cat-slug={slug}
          class="tool-card group relative flex flex-col gap-2 p-4 bg-surface0 rounded-xl border border-surface1 hover:border-lavender/40 transition-all duration-200 overflow-hidden"
          style={`--card-accent: ${config.accent};`}
        >
          <div
            class="absolute inset-0 opacity-0 group-hover:opacity-100 transition-opacity duration-200"
            style={`background: radial-gradient(circle at 50% 0%, ${config.accent}15 0%, transparent 70%);`}
            aria-hidden="true"
          />
          <div class="relative flex items-center justify-between">
            <span class="font-semibold text-sm text-text">{config.label}</span>
            <span
              class="text-xs font-mono px-1.5 py-0.5 rounded-full"
              style={`background-color: ${config.accent}20; color: ${config.accent};`}
            >
              {categoryCounts[slug] ?? 0}
            </span>
          </div>
          <p class="relative text-xs text-subtext1 leading-relaxed line-clamp-2">
            {config.description}
          </p>
        </a>
      ))}
    </div>
  </section>

  <!-- Recently Added -->
  {recentTools.length > 0 && (
    <section class="mb-8 stagger-in" style="--i: 4" aria-labelledby="recent-heading">
      <h2 id="recent-heading" class="text-xl font-bold text-text flex items-center gap-2 mb-6">
        <svg class="w-5 h-5 text-teal" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <circle cx="12" cy="12" r="10"/>
          <polyline points="12 6 12 12 16 14"/>
        </svg>
        Añadidas Recientemente
      </h2>
      <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-4">
        {recentTools.map((tool) => (
          <ToolCard
            name={tool.data.name}
            description={tool.data.description}
            tags={tool.data.tags}
            os={tool.data.os}
            category={tool.collectionName}
            slug={tool.slug}
            featured={tool.data.featured}
            difficulty={tool.data.difficulty}
            install={tool.data.install}
            accent={categoryAccents[tool.collectionName] ?? '#8caaee'}
          />
        ))}
      </div>
    </section>
  )}

</BaseLayout>

<script>
  document.getElementById('hero-search-btn')?.addEventListener('click', () => {
    window.dispatchEvent(new CustomEvent('open-command-palette'));
  });

  // Featured category icon fallback
  document.querySelectorAll<HTMLImageElement>('img.featured-cat-icon').forEach((img) => {
    const fallback = () => {
      const span = document.createElement('span');
      span.className = 'font-bold text-base';
      span.style.color = img.dataset.accent ?? '#8caaee';
      span.textContent = img.dataset.fallback ?? '?';
      img.replaceWith(span);
    };
    if (img.complete && img.naturalWidth === 0) fallback();
    else img.addEventListener('error', fallback);
  });

  // Typewriter
  const commands = [
    'winget install sharkdp.bat',
    'brew install fzf',
    'cargo install zoxide',
    'scoop install lazygit',
    'apt install ripgrep',
    'npm install -g tldr',
  ];
  let ci = 0, ci2 = 0, deleting = false, paused = false;
  const el = document.getElementById('typewriter');

  function type() {
    if (!el) return;
    const cmd = commands[ci % commands.length];
    if (paused) {
      paused = false;
      deleting = true;
      setTimeout(type, 1500);
      return;
    }
    if (!deleting) {
      el.textContent = cmd.slice(0, ci2 + 1);
      ci2++;
      if (ci2 === cmd.length) { paused = true; setTimeout(type, 80); return; }
      setTimeout(type, 60);
    } else {
      el.textContent = cmd.slice(0, ci2 - 1);
      ci2--;
      if (ci2 === 0) { deleting = false; ci++; setTimeout(type, 400); return; }
      setTimeout(type, 30);
    }
  }
  if (el) setTimeout(type, 1000);

  // Featured categories: wheel → horizontal scroll + click-drag
  function initFeatCatsScroll() {
    const scroller = document.getElementById('feat-cats-scroll');
    if (!scroller) return;

    // Wheel → horizontal scroll
    scroller.addEventListener('wheel', (e) => {
      if (Math.abs(e.deltaX) > Math.abs(e.deltaY)) return;
      e.preventDefault();
      scroller.scrollBy({ left: e.deltaY * 1.2, behavior: 'smooth' });
    }, { passive: false });

    // Click-drag
    let dragging = false;
    let hasDragged = false;
    let startX = 0;
    let startScroll = 0;

    scroller.addEventListener('mousedown', (e) => {
      if (e.button !== 0) return;
      dragging = true;
      hasDragged = false;
      startX = e.clientX;
      startScroll = scroller.scrollLeft;
      scroller.style.cursor = 'grabbing';
      e.preventDefault();
    });

    window.addEventListener('mousemove', (e) => {
      if (!dragging) return;
      const dx = e.clientX - startX;
      if (Math.abs(dx) > 3) hasDragged = true;
      scroller.scrollLeft = startScroll - dx;
    });

    window.addEventListener('mouseup', () => {
      if (!dragging) return;
      dragging = false;
      scroller.style.cursor = 'grab';
    });

    // Block link navigation after a real drag
    scroller.addEventListener('click', (e) => {
      if (hasDragged) {
        e.preventDefault();
        e.stopPropagation();
        hasDragged = false;
      }
    }, true);
  }

  initFeatCatsScroll();
  document.addEventListener('astro:page-load', initFeatCatsScroll);
</script>
