---
import { getStars, formatStars, REPO_URL } from '../../lib/github';

interface Props {
  /** "block" fills the sidebar width; "compact" sits in the header row. */
  variant?: 'block' | 'compact';
}

const { variant = 'block' } = Astro.props;
const stars = await getStars();
// With zero or unknown stars the count adds nothing; the call to action still stands.
const showCount = stars !== null && stars >= 1;
const label = showCount
  ? `Star: dar una estrella a DevPiece en GitHub (${stars})`
  : 'Star: dar una estrella a DevPiece en GitHub';
---

<a
  href={REPO_URL}
  target="_blank"
  rel="noopener noreferrer"
  aria-label={label}
  data-tip="Star en GitHub"
  class:list={[
    'gh-star group/star inline-flex items-center rounded-md border border-surface1 bg-crust/60 text-sm text-text',
    'transition-colors duration-fast hover:border-yellow/50 hover:bg-crust',
    variant === 'block' ? 'w-full gap-2 px-3 py-2' : 'gap-1.5 px-2.5 py-1.5',
  ]}
>
  <svg class="w-4 h-4 flex-shrink-0" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
    <path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0 0 24 12c0-6.63-5.37-12-12-12z"/>
  </svg>
  <span class="rail-label flex items-center gap-1.5 font-medium">
    <svg class="w-3.5 h-3.5 text-yellow transition-transform duration-slow ease-out-expo group-hover/star:scale-110" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
      <path d="M11.48 3.5a.56.56 0 0 1 1.04 0l2.13 5.11a.56.56 0 0 0 .48.35l5.52.44c.5.04.7.66.32.99l-4.2 3.6a.56.56 0 0 0-.18.56l1.28 5.39a.56.56 0 0 1-.84.61l-4.73-2.89a.56.56 0 0 0-.59 0l-4.72 2.89a.56.56 0 0 1-.84-.61l1.28-5.39a.56.56 0 0 0-.18-.56l-4.2-3.6a.56.56 0 0 1 .32-.99l5.52-.44a.56.56 0 0 0 .47-.35z"/>
    </svg>
    Star
  </span>
  {showCount && (
    <span class="rail-label ml-auto pl-2 border-l border-surface1 font-mono text-xs tabular text-subtext1">
      {formatStars(stars!)}
    </span>
  )}
</a>
