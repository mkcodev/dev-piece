---
// Mobile drawer: native <dialog> gives Escape, focus containment and an inert
// background for free. Same tree as the desktop sidebar (NavTree).
import NavTree from './NavTree.astro';
import GithubStar from './GithubStar.astro';
import Icon from '../common/Icon.astro';
---

<button
  type="button"
  class="js-drawer-open flex items-center justify-center w-10 h-10 -ml-2 rounded-md text-text hover:bg-surface0 transition-colors"
  aria-label="Abrir menú"
  aria-haspopup="dialog"
  aria-controls="nav-drawer"
  aria-expanded="false"
>
  <Icon name="menu" class="w-5 h-5" />
</button>

<dialog id="nav-drawer" class="nav-drawer" aria-label="Menú de navegación">
  <div class="nav-drawer-panel js-drawer-panel">
    <div class="flex items-center gap-2 p-3 pl-4 border-b border-surface0">
      <a href="/" class="flex items-center gap-2 mr-auto rounded-md">
        <img src="/devpiece-logo.png" alt="" width="36" height="36" class="w-9 h-9 object-contain" />
        <span class="font-bold text-text tracking-tight">DevPiece</span>
      </a>
      <button
        type="button"
        class="js-drawer-close flex items-center justify-center w-10 h-10 rounded-md text-subtext1 hover:text-text hover:bg-surface0 transition-colors"
        aria-label="Cerrar menú"
      >
        <Icon name="x" class="w-5 h-5" />
      </button>
    </div>

    <div class="px-3 pt-3">
      <GithubStar variant="block" />
    </div>

    <nav class="flex-1 overflow-y-auto overscroll-contain p-3" aria-label="Categorías y secciones">
      <NavTree variant="drawer" />
    </nav>

    <p class="px-4 py-3 border-t border-surface0 text-xs text-subtext1">
      Desliza hacia la izquierda o pulsa Esc para cerrar
    </p>
  </div>
</dialog>
