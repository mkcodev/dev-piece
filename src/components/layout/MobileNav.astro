---
import { getCollection } from 'astro:content';
import { CATEGORY_CONFIG } from '../../lib/utils';

const currentPath = Astro.url.pathname;

const navItems = Object.entries(CATEGORY_CONFIG).map(([slug, config]) => ({
  slug,
  ...config,
  href: `/${slug}`,
  active: currentPath.startsWith(`/${slug}`),
}));
---

<div x-data="{ open: false }" class="relative">
  <button
    @click="open = true"
    class="flex items-center justify-center w-8 h-8 rounded-lg hover:bg-surface0 transition-colors"
    aria-label="Abrir menú de navegación"
    aria-expanded="false"
    :aria-expanded="open.toString()"
  >
    <svg class="w-5 h-5 text-text" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
      <line x1="3" y1="6" x2="21" y2="6"/>
      <line x1="3" y1="12" x2="21" y2="12"/>
      <line x1="3" y1="18" x2="21" y2="18"/>
    </svg>
  </button>

  <!-- Overlay -->
  <div
    x-show="open"
    x-transition:enter="transition ease-out duration-200"
    x-transition:enter-start="opacity-0"
    x-transition:enter-end="opacity-100"
    x-transition:leave="transition ease-in duration-150"
    x-transition:leave-start="opacity-100"
    x-transition:leave-end="opacity-0"
    @click="open = false"
    class="fixed inset-0 bg-crust/80 backdrop-blur-sm z-40"
    style="display:none"
    aria-hidden="true"
  />

  <!-- Drawer -->
  <div
    x-show="open"
    x-transition:enter="transition ease-out duration-200"
    x-transition:enter-start="opacity-0 -translate-x-full"
    x-transition:enter-end="opacity-100 translate-x-0"
    x-transition:leave="transition ease-in duration-150"
    x-transition:leave-start="opacity-100 translate-x-0"
    x-transition:leave-end="opacity-0 -translate-x-full"
    class="fixed inset-y-0 left-0 w-72 bg-mantle border-r border-surface0 z-50 overflow-y-auto"
    style="display:none"
    role="dialog"
    aria-modal="true"
    aria-label="Menú de navegación móvil"
  >
    <div class="p-4 border-b border-surface0 flex items-center justify-between">
      <a href="/" class="flex items-center gap-2" @click="open = false">
        <img src="/devpiece-logo.png" alt="" class="w-10 h-10 object-contain" />
        <span class="font-bold text-text">DevPiece</span>
      </a>
      <button
        @click="open = false"
        class="w-8 h-8 flex items-center justify-center rounded-lg hover:bg-surface0 transition-colors"
        aria-label="Cerrar menú"
      >
        <svg class="w-4 h-4 text-subtext1" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <line x1="18" y1="6" x2="6" y2="18"/>
          <line x1="6" y1="6" x2="18" y2="18"/>
        </svg>
      </button>
    </div>

    <nav class="p-3 space-y-0.5">
      <a
        href="/"
        @click="open = false"
        class:list={[
          "flex items-center gap-2 px-3 py-2 rounded-lg text-sm transition-all",
          currentPath === '/'
            ? "sidebar-link-active font-medium"
            : "text-subtext1 hover:text-text hover:bg-surface0/50"
        ]}
      >
        Inicio
      </a>

      <a
        href="/roadmaps"
        @click="open = false"
        class:list={[
          "flex items-center gap-2 px-3 py-2 rounded-lg text-sm transition-all",
          currentPath.startsWith('/roadmaps')
            ? "sidebar-link-active font-medium"
            : "text-subtext1 hover:text-text hover:bg-surface0/50"
        ]}
      >
        <svg class="w-4 h-4 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 20l-5.447-2.724A1 1 0 013 16.382V5.618a1 1 0 011.447-.894L9 7m0 13l6-3m-6 3V7m6 13l4.553 2.276A1 1 0 0021 21.382V10.618a1 1 0 00-.553-.894L15 7m0 13V7m0 0L9 4"/>
        </svg>
        Roadmaps
      </a>

      <a
        href="/guias"
        @click="open = false"
        class:list={[
          "flex items-center gap-2 px-3 py-2 rounded-lg text-sm transition-all",
          currentPath.startsWith('/guias')
            ? "sidebar-link-active font-medium"
            : "text-subtext1 hover:text-text hover:bg-surface0/50"
        ]}
      >
        <svg class="w-4 h-4 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"/>
        </svg>
        Guías
      </a>

      <a
        href="/arsenal"
        @click="open = false"
        class:list={[
          "flex items-center gap-2 px-3 py-2 rounded-lg text-sm transition-all",
          currentPath.startsWith('/arsenal')
            ? "sidebar-link-active font-medium"
            : "text-subtext1 hover:text-text hover:bg-surface0/50"
        ]}
      >
        <svg class="w-4 h-4 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 3l14 9-14 9V3z"/>
        </svg>
        Mi Arsenal
      </a>

      {navItems.map((item) => (
        <a
          href={item.href}
          @click="open = false"
          class:list={[
            "flex items-center justify-between px-3 py-2 rounded-lg text-sm transition-all",
            item.active
              ? "sidebar-link-active font-medium"
              : "text-subtext1 hover:text-text hover:bg-surface0/50"
          ]}
        >
          <span>{item.label}</span>
        </a>
      ))}
    </nav>
  </div>
</div>

<script>
  // Simple Alpine.js-free fallback using vanilla JS
  const btn = document.querySelector('[aria-label="Abrir menú de navegación"]') as HTMLButtonElement;
  const closeBtn = document.querySelector('[aria-label="Cerrar menú"]') as HTMLButtonElement;
  const overlay = document.querySelector('[aria-hidden="true"]') as HTMLElement;
  const drawer = document.querySelector('[role="dialog"]') as HTMLElement;

  function openMenu() {
    if (drawer) { drawer.style.display = 'block'; btn?.setAttribute('aria-expanded', 'true'); }
    if (overlay) { overlay.style.display = 'block'; }
    document.body.style.overflow = 'hidden';
  }
  function closeMenu() {
    if (drawer) { drawer.style.display = 'none'; btn?.setAttribute('aria-expanded', 'false'); }
    if (overlay) { overlay.style.display = 'none'; }
    document.body.style.overflow = '';
  }

  btn?.addEventListener('click', openMenu);
  closeBtn?.addEventListener('click', closeMenu);
  overlay?.addEventListener('click', closeMenu);

  // Close on nav link click
  drawer?.querySelectorAll('a').forEach(a => a.addEventListener('click', closeMenu));
</script>
