---
import { getCollection } from 'astro:content';
import { CATEGORY_CONFIG } from '../../lib/utils';

const currentPath = Astro.url.pathname;

// Get tool counts per category
const categoryCounts: Record<string, number> = {};
for (const cat of Object.keys(CATEGORY_CONFIG)) {
  try {
    const entries = await getCollection(cat as any);
    categoryCounts[cat] = entries.length;
  } catch {
    categoryCounts[cat] = 0;
  }
}

const navItems = Object.entries(CATEGORY_CONFIG).map(([slug, config], idx) => ({
  slug,
  ...config,
  count: categoryCounts[slug] ?? 0,
  href: `/${slug}`,
  active: currentPath.startsWith(`/${slug}`),
  index: idx,
}));
---

<aside
  class="hidden lg:flex flex-col fixed left-0 top-0 h-screen w-[240px] bg-mantle border-r border-surface0 z-40 overflow-y-auto"
  aria-label="Navegación principal"
>
  <!-- Logo -->
  <div class="p-5 border-b border-surface0">
    <a href="/" class="flex items-center gap-2 group">
      <img src="/devpiece-logo.png" alt="DevPiece" class="w-11 h-11 object-contain flex-shrink-0 group-hover:scale-105 transition-transform duration-200" />
      <div>
        <span class="font-bold text-text text-base leading-tight block">DevPiece</span>
        <span class="text-xs text-subtext0 leading-tight block">Tu arsenal dev</span>
      </div>
    </a>
  </div>

  <!-- Navigation -->
  <nav class="flex-1 p-3 space-y-0.5 sidebar-pill-track" aria-label="Categorías">
    <a
      href="/"
      data-cat-index="-1"
      class:list={[
        "relative z-10 flex items-center gap-2.5 px-3 py-2 rounded-lg text-sm transition-all duration-150",
        currentPath === '/'
          ? "sidebar-link-active font-medium"
          : "text-subtext1 hover:text-text hover:bg-surface0/50"
      ]}
    >
      <svg class="w-4 h-4 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/>
        <polyline stroke-linecap="round" stroke-linejoin="round" stroke-width="2" points="9 22 9 12 15 12 15 22"/>
      </svg>
      <span>Inicio</span>
    </a>

    <!-- Roadmaps link -->
    <a
      href="/roadmaps"
      data-cat-index="-1"
      class:list={[
        "relative z-10 flex items-center gap-2.5 px-3 py-2 rounded-lg text-sm transition-all duration-150",
        currentPath.startsWith('/roadmaps')
          ? "sidebar-link-active font-medium"
          : "text-subtext1 hover:text-text hover:bg-surface0/50"
      ]}
    >
      <svg class="w-4 h-4 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 20l-5.447-2.724A1 1 0 013 16.382V5.618a1 1 0 011.447-.894L9 7m0 13l6-3m-6 3V7m6 13l4.553 2.276A1 1 0 0021 21.382V10.618a1 1 0 00-.553-.894L15 7m0 13V7m0 0L9 4"/>
      </svg>
      <span>Roadmaps</span>
      <span class="ml-auto text-xs bg-lavender/20 text-lavender px-1.5 py-0.5 rounded-full font-mono">5</span>
    </a>

    <!-- Guías link -->
    <a
      href="/guias"
      data-cat-index="-1"
      class:list={[
        "relative z-10 flex items-center gap-2.5 px-3 py-2 rounded-lg text-sm transition-all duration-150",
        currentPath.startsWith('/guias')
          ? "sidebar-link-active font-medium"
          : "text-subtext1 hover:text-text hover:bg-surface0/50"
      ]}
    >
      <svg class="w-4 h-4 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"/>
      </svg>
      <span>Guías</span>
    </a>

    <!-- Mi Arsenal link -->
    <a
      href="/arsenal"
      data-cat-index="-1"
      class:list={[
        "relative z-10 flex items-center gap-2.5 px-3 py-2 rounded-lg text-sm transition-all duration-150",
        currentPath.startsWith('/arsenal')
          ? "sidebar-link-active font-medium"
          : "text-subtext1 hover:text-text hover:bg-surface0/50"
      ]}
    >
      <svg class="w-4 h-4 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 3l14 9-14 9V3z"/>
      </svg>
      <span>Mi Arsenal</span>
      <!-- Unique tools in favorites ∪ integrations, filled client-side -->
      <span
        id="sidebar-arsenal-count"
        class="ml-auto text-xs bg-lavender/20 text-lavender px-1.5 py-0.5 rounded-full font-mono hidden"
        title="Herramientas en tu arsenal"
      ></span>
    </a>

    <div class="pt-2 pb-1 px-3">
      <span class="text-xs font-semibold text-overlay2 uppercase tracking-wider">Herramientas</span>
    </div>

    {navItems.map((item) => (
      <a
        href={item.href}
        data-cat-index={item.index}
        class:list={[
          "relative z-10 flex items-center justify-between px-3 py-2 rounded-lg text-sm transition-colors duration-150",
          item.active
            ? "sidebar-link-active font-medium"
            : "text-subtext1 hover:text-text hover:bg-surface0/50"
        ]}
      >
        <span class="flex-1 leading-tight">{item.label}</span>
        {item.count > 0 && (
          <span class:list={[
            "text-xs px-1.5 py-0.5 rounded-full font-mono flex-shrink-0 ml-2 transition-colors duration-300 accent-morph",
            item.active ? "bg-surface1 text-text" : "bg-surface0/60 text-subtext0"
          ]}>
            {item.count}
          </span>
        )}
      </a>
    ))}
  </nav>

  <!-- Bottom links -->
  <div class="p-3 border-t border-surface0 space-y-1">
    <a
      href="https://github.com/mkcodev/dev-piece"
      target="_blank"
      rel="noopener noreferrer"
      class="flex items-center gap-2 px-3 py-2 rounded-lg text-sm text-subtext1 hover:text-text hover:bg-surface0/50 transition-all"
    >
      <svg class="w-4 h-4 flex-shrink-0" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
        <path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0 0 24 12c0-6.63-5.37-12-12-12z"/>
      </svg>
      <span>GitHub</span>
      <svg class="w-3 h-3 ml-auto opacity-50" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6m4-3h6v6m-11 5L21 3"/>
      </svg>
    </a>
    <a
      href="#contribuir"
      class="flex items-center gap-2 px-3 py-2 rounded-lg text-sm text-subtext1 hover:text-text hover:bg-surface0/50 transition-all"
    >
      <svg class="w-4 h-4 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/>
      </svg>
      <span>Contribuir</span>
    </a>
  </div>
</aside>

<script>
  function updateArsenalCount() {
    const badge = document.getElementById('sidebar-arsenal-count');
    if (!badge) return;
    try {
      const favs = JSON.parse(localStorage.getItem('devpiece-favorites')     ?? '[]');
      const ints = JSON.parse(localStorage.getItem('devpiece-integrations')  ?? '[]');
      const unique = new Set(
        [...(Array.isArray(favs) ? favs : []), ...(Array.isArray(ints) ? ints : [])]
          .map((t: any) => `${t.category}/${t.slug}`)
      );
      badge.textContent = String(unique.size);
      badge.classList.toggle('hidden', unique.size === 0);
    } catch {}
  }
  updateArsenalCount();
  window.addEventListener('favorites-updated',    updateArsenalCount);
  window.addEventListener('integrations-updated', updateArsenalCount);
  window.addEventListener('storage',              updateArsenalCount);
  document.addEventListener('astro:page-load',    updateArsenalCount);
</script>
