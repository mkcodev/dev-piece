---
import NavTree from './NavTree.astro';
import GithubStar from './GithubStar.astro';
import Icon from '../common/Icon.astro';
---

<aside
  id="app-sidebar"
  class="sidebar hidden lg:flex flex-col fixed left-0 top-0 h-screen bg-mantle border-r border-surface0 z-40"
  aria-label="Barra lateral"
>
  <div class="sidebar-head flex flex-col gap-3 p-3 pb-4 border-b border-surface0">
    <a href="/" class="sidebar-brand flex items-center gap-2.5 rounded-md px-1 group" data-tip="Inicio">
      <img src="/devpiece-logo.png" alt="" width="40" height="40" class="w-10 h-10 object-contain flex-shrink-0 transition-transform duration-base ease-out-expo group-hover:scale-105" />
      <span class="rail-label leading-tight">
        <span class="block font-bold text-text text-base tracking-tight">DevPiece</span>
        <span class="block text-xs text-subtext1">Tu arsenal dev</span>
      </span>
    </a>
    <GithubStar variant="block" />
  </div>

  <nav class="sidebar-scroll flex-1 overflow-y-auto overscroll-contain p-3" aria-label="Categorías y secciones">
    <NavTree variant="sidebar" />
  </nav>

  <div class="flex flex-col gap-0.5 p-3 border-t border-surface0">
    <a href="#contribuir" class="nav-link" data-tip="Contribuir">
      <Icon name="git-pull-request-arrow" class="nav-icon" />
      <span class="rail-label">Contribuir</span>
    </a>
    <button
      type="button"
      class="nav-link js-rail-toggle"
      aria-controls="app-sidebar"
      aria-expanded="true"
      aria-keyshortcuts="["
      data-tip="Expandir barra  ["
    >
      <Icon name="panel-left-close" class="nav-icon rail-icon-close" />
      <Icon name="panel-left-open" class="nav-icon rail-icon-open" />
      <span class="rail-label">Contraer</span>
      <kbd class="rail-label ml-auto rounded border border-surface1 px-1.5 text-2xs text-subtext1">[</kbd>
    </button>
  </div>
</aside>

<script>
  import { initNav } from '../../scripts/nav';
  initNav();
</script>
