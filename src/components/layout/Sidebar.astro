---
import { getCollection } from 'astro:content';
import { CATEGORY_CONFIG } from '../../lib/utils';

const currentPath = Astro.url.pathname;

// Get tool counts per category
const categoryCounts: Record<string, number> = {};
for (const cat of Object.keys(CATEGORY_CONFIG)) {
  try {
    const entries = await getCollection(cat as any);
    categoryCounts[cat] = entries.length;
  } catch {
    categoryCounts[cat] = 0;
  }
}

const navItems = Object.entries(CATEGORY_CONFIG).map(([slug, config]) => ({
  slug,
  ...config,
  count: categoryCounts[slug] ?? 0,
  href: `/${slug}`,
  active: currentPath.startsWith(`/${slug}`),
}));
---

<aside
  class="hidden lg:flex flex-col fixed left-0 top-0 h-screen w-[240px] bg-mantle border-r border-surface0 z-40 overflow-y-auto"
  aria-label="Navegación principal"
>
  <!-- Logo -->
  <div class="p-5 border-b border-surface0">
    <a href="/" class="flex items-center gap-2 group">
      <div class="w-8 h-8 rounded-lg bg-gradient-to-br from-blue to-lavender flex items-center justify-center text-crust font-bold text-sm flex-shrink-0">
        DV
      </div>
      <div>
        <span class="font-bold text-text text-base leading-tight block">DevVault</span>
        <span class="text-xs text-subtext0 leading-tight block">Tu arsenal dev</span>
      </div>
    </a>
  </div>

  <!-- Navigation -->
  <nav class="flex-1 p-3 space-y-0.5">
    <a
      href="/"
      class:list={[
        "flex items-center gap-2.5 px-3 py-2 rounded-lg text-sm transition-all duration-150 group",
        currentPath === '/'
          ? "sidebar-link-active font-medium"
          : "text-subtext1 hover:text-text hover:bg-surface0/50"
      ]}
    >
      <svg class="w-4 h-4 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/>
        <polyline stroke-linecap="round" stroke-linejoin="round" stroke-width="2" points="9 22 9 12 15 12 15 22"/>
      </svg>
      <span>Inicio</span>
    </a>

    <div class="pt-2 pb-1 px-3">
      <span class="text-xs font-semibold text-overlay2 uppercase tracking-wider">Herramientas</span>
    </div>

    {navItems.map((item) => (
      <a
        href={item.href}
        class:list={[
          "flex items-center justify-between px-3 py-2 rounded-lg text-sm transition-all duration-150 group",
          item.active
            ? "sidebar-link-active font-medium"
            : "text-subtext1 hover:text-text hover:bg-surface0/50"
        ]}
      >
        <span class="flex-1 leading-tight">{item.label}</span>
        {item.count > 0 && (
          <span class:list={[
            "text-xs px-1.5 py-0.5 rounded-full font-mono flex-shrink-0 ml-2",
            item.active ? "bg-surface1 text-text" : "bg-surface0/60 text-subtext0"
          ]}>
            {item.count}
          </span>
        )}
      </a>
    ))}
  </nav>

  <!-- Bottom links -->
  <div class="p-3 border-t border-surface0 space-y-1">
    <a
      href="https://github.com/devvault/devvault"
      target="_blank"
      rel="noopener noreferrer"
      class="flex items-center gap-2 px-3 py-2 rounded-lg text-sm text-subtext1 hover:text-text hover:bg-surface0/50 transition-all"
    >
      <svg class="w-4 h-4 flex-shrink-0" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
        <path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0 0 24 12c0-6.63-5.37-12-12-12z"/>
      </svg>
      <span>GitHub</span>
      <svg class="w-3 h-3 ml-auto opacity-50" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6m4-3h6v6m-11 5L21 3"/>
      </svg>
    </a>
    <a
      href="#contribuir"
      class="flex items-center gap-2 px-3 py-2 rounded-lg text-sm text-subtext1 hover:text-text hover:bg-surface0/50 transition-all"
    >
      <svg class="w-4 h-4 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/>
      </svg>
      <span>Contribuir</span>
    </a>
  </div>
</aside>
