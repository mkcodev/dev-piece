---
import MobileNav from './MobileNav.astro';
import LoginModal from './LoginModal';
import GithubStar from './GithubStar.astro';
import Icon from '../common/Icon.astro';
import { getCollection } from 'astro:content';
import { CATEGORY_CONFIG } from '../../lib/utils';

const currentPath = Astro.url.pathname;

// Get tool counts per category
const categoryCounts: Record<string, number> = {};
for (const cat of Object.keys(CATEGORY_CONFIG)) {
  try {
    const entries = await getCollection(cat as any);
    categoryCounts[cat] = entries.length;
  } catch {
    categoryCounts[cat] = 0;
  }
}

const categories = Object.entries(CATEGORY_CONFIG).map(([slug, config]) => ({
  slug,
  ...config,
  count: categoryCounts[slug] ?? 0,
  href: `/${slug}`,
}));

const TECH_ROADMAPS = [
  { slug: 'front-dev', label: 'FrontDev', description: 'React-first: HTML → CSS → JS → React → Next.js', accent: '#8caaee', icon: '🌐' },
  { slug: 'back-dev',  label: 'BackDev',  description: 'Node.js → Express → Bases de datos → APIs', accent: '#a6d189', icon: '⚙️' },
  { slug: 'full-dev',  label: 'FullDev',  description: 'El camino completo: Front + Back + Deploy', accent: '#ca9ee6', icon: '🚀' },
];

const TOOLS_ROADMAPS = [
  { slug: 'junior-dev', label: 'JuniorDev', description: 'Setup esencial para tu primer trabajo dev', accent: '#ef9f76', icon: '🌱' },
  { slug: 'ninja-dev',  label: 'NinjaDev',  description: 'Terminal + Git + Windows + Unix power tools', accent: '#f4b8e4', icon: '🥷' },
];

---

<header class="sticky top-0 z-30 bg-mantle/80 backdrop-blur-md border-b border-surface0 h-14 flex items-center px-4 md:px-6">
  <!-- Mobile menu -->
  <div class="lg:hidden mr-3">
    <MobileNav />
  </div>

  <!-- Mobile logo -->
  <a href="/" class="lg:hidden flex items-center gap-2 mr-auto">
    <img src="/devpiece-logo.png" alt="" class="w-10 h-10 object-contain" />
    <span class="font-bold text-text text-sm">DevPiece</span>
  </a>

  <!-- Desktop nav -->
  <nav class="hidden lg:flex items-center gap-1 flex-1" aria-label="Navegación principal">

    <!-- Categorías mega menu -->
    <div class="relative group/cat" id="cat-menu">
      <button
        class="flex items-center gap-1.5 px-3 py-1.5 rounded-lg text-sm text-subtext1 hover:text-text hover:bg-surface0 transition-colors"
        aria-haspopup="true"
      >
        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/>
        </svg>
        Categorías
        <svg class="w-3 h-3 transition-transform duration-150 group-hover/cat:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m6 9 6 6 6-6"/>
        </svg>
      </button>

      <!-- Invisible bridge to prevent panel close on mouse move -->
      <div class="absolute top-full left-0 h-3 w-full pointer-events-auto opacity-0" aria-hidden="true"></div>

      <!-- Dropdown panel -->
      <div class="absolute top-[calc(100%+0.75rem)] left-0 w-[720px] bg-mantle border border-surface1 rounded-2xl shadow-2xl opacity-0 invisible pointer-events-none group-hover/cat:opacity-100 group-hover/cat:visible group-hover/cat:pointer-events-auto transition-all duration-150 z-50 p-5">
        <div class="flex items-center justify-between mb-4">
          <p class="text-xs font-semibold text-overlay2 uppercase tracking-wider">Todas las categorías</p>
          <a href="/" class="text-xs text-lavender hover:text-text transition-colors">Ver inicio →</a>
        </div>
        <div class="grid grid-cols-4 gap-2">
          {categories.map((cat) => {
            return (
              <a
                href={cat.href}
                class:list={[
                  "flex items-center gap-2.5 p-2.5 rounded-xl hover:bg-surface0 transition-all duration-150 group/item",
                  currentPath.startsWith(cat.href) ? "bg-surface0/60" : ""
                ]}
              >
                <div
                  class="w-7 h-7 rounded-lg flex items-center justify-center flex-shrink-0 overflow-hidden"
                  style={`background-color: ${cat.accent}20;`}
                  aria-hidden="true"
                >
                  <span style={`color: ${cat.accent};`}><Icon name={cat.icon} class="w-4 h-4" /></span>
                </div>
                <div class="min-w-0 flex-1">
                  <p class="text-xs font-medium text-text leading-tight truncate">{cat.label}</p>
                  {cat.count > 0 && (
                    <p class="text-xs text-subtext1">{cat.count} herramienta{cat.count !== 1 ? 's' : ''}</p>
                  )}
                </div>
              </a>
            );
          })}
        </div>
      </div>
    </div>

    <!-- Roadmaps mega menu -->
    <div class="relative group/road" id="road-menu">
      <button
        class="flex items-center gap-1.5 px-3 py-1.5 rounded-lg text-sm text-subtext1 hover:text-text hover:bg-surface0 transition-colors"
        aria-haspopup="true"
      >
        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 20l-5.447-2.724A1 1 0 013 16.382V5.618a1 1 0 011.447-.894L9 7m0 13l6-3m-6 3V7m6 13l4.553 2.276A1 1 0 0021 21.382V10.618a1 1 0 00-.553-.894L15 7m0 13V7m0 0L9 4"/>
        </svg>
        Roadmaps
        <svg class="w-3 h-3 transition-transform duration-150 group-hover/road:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m6 9 6 6 6-6"/>
        </svg>
      </button>

      <!-- Invisible bridge -->
      <div class="absolute top-full left-0 h-3 w-full pointer-events-auto opacity-0" aria-hidden="true"></div>

      <!-- Dropdown panel -->
      <div class="absolute top-[calc(100%+0.75rem)] left-0 w-[480px] bg-mantle border border-surface1 rounded-2xl shadow-2xl opacity-0 invisible pointer-events-none group-hover/road:opacity-100 group-hover/road:visible group-hover/road:pointer-events-auto transition-all duration-150 z-50 overflow-hidden">
        <!-- Tabs -->
        <div class="flex border-b border-surface0 bg-crust/30">
          <button
            class="road-tab flex-1 px-4 py-3 text-sm font-medium transition-colors road-tab-active"
            data-tab="tech"
          >
            <span class="flex items-center justify-center gap-2">
              <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4"/>
              </svg>
              Tech
            </span>
          </button>
          <button
            class="road-tab flex-1 px-4 py-3 text-sm font-medium transition-colors"
            data-tab="tools"
          >
            <span class="flex items-center justify-center gap-2">
              <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"/><circle cx="12" cy="12" r="3"/>
              </svg>
              Tools
            </span>
          </button>
        </div>

        <!-- Tech tab content -->
        <div class="road-panel p-4 space-y-2" data-panel="tech">
          {TECH_ROADMAPS.map((r) => (
            <a
              href={`/roadmaps/${r.slug}`}
              class="flex items-start gap-3 p-3 rounded-xl hover:bg-surface0 transition-all duration-150 group/r"
            >
              <div
                class="w-9 h-9 rounded-xl flex items-center justify-center flex-shrink-0 text-lg"
                style={`background-color: ${r.accent}20;`}
              >
                {r.icon}
              </div>
              <div class="min-w-0 flex-1">
                <p class="text-sm font-semibold text-text group-hover/r:text-blue transition-colors">{r.label}</p>
                <p class="text-xs text-subtext1 mt-0.5 leading-relaxed">{r.description}</p>
              </div>
              <svg class="w-3.5 h-3.5 text-subtext1 group-hover/r:text-blue flex-shrink-0 mt-1 transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m9 18 6-6-6-6"/>
              </svg>
            </a>
          ))}
          <div class="pt-2 border-t border-surface0/50">
            <a href="/roadmaps" class="flex items-center gap-2 px-3 py-2 text-xs text-lavender hover:text-text transition-colors">
              Ver todos los roadmaps
              <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m9 18 6-6-6-6"/>
              </svg>
            </a>
          </div>
        </div>

        <!-- Tools tab content -->
        <div class="road-panel p-4 space-y-2 hidden" data-panel="tools">
          {TOOLS_ROADMAPS.map((r) => (
            <a
              href={`/roadmaps/${r.slug}`}
              class="flex items-start gap-3 p-3 rounded-xl hover:bg-surface0 transition-all duration-150 group/r"
            >
              <div
                class="w-9 h-9 rounded-xl flex items-center justify-center flex-shrink-0 text-lg"
                style={`background-color: ${r.accent}20;`}
              >
                {r.icon}
              </div>
              <div class="min-w-0 flex-1">
                <p class="text-sm font-semibold text-text group-hover/r:text-blue transition-colors">{r.label}</p>
                <p class="text-xs text-subtext1 mt-0.5 leading-relaxed">{r.description}</p>
              </div>
              <svg class="w-3.5 h-3.5 text-subtext1 group-hover/r:text-blue flex-shrink-0 mt-1 transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m9 18 6-6-6-6"/>
              </svg>
            </a>
          ))}
          <div class="pt-2 border-t border-surface0/50">
            <a href="/roadmaps" class="flex items-center gap-2 px-3 py-2 text-xs text-lavender hover:text-text transition-colors">
              Ver todos los roadmaps
              <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m9 18 6-6-6-6"/>
              </svg>
            </a>
          </div>
        </div>
      </div>
    </div>

    <!-- Direct roadmaps link (visible always) -->
    <a
      href="/roadmaps"
      class:list={[
        "flex items-center gap-1.5 px-3 py-1.5 rounded-lg text-sm transition-colors",
        currentPath.startsWith('/roadmaps')
          ? "text-text bg-surface0 font-medium"
          : "text-subtext1 hover:text-text hover:bg-surface0"
      ]}
    >
      Ver roadmaps
    </a>
  </nav>

  <!-- Right side actions -->
  <div class="hidden lg:flex items-center gap-2 ml-auto">
    <GithubStar variant="compact" />
    <!-- Cmd+K trigger -->
    <button
      id="open-palette-btn"
      class="flex items-center gap-2 px-3 py-1.5 bg-surface0 hover:bg-surface1 border border-surface1 hover:border-surface2 rounded-lg text-sm text-subtext1 hover:text-text transition-all duration-150"
      aria-keyshortcuts="Control+k Meta+k"
    >
      <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
        <circle cx="11" cy="11" r="8"/>
        <line x1="21" y1="21" x2="16.65" y2="16.65"/>
      </svg>
      <span class="hidden sm:inline">Buscar</span>
      <span class="hidden sm:flex items-center gap-0.5 ml-1" aria-hidden="true">
        <kbd class="text-xs bg-surface1 text-overlay2 px-1 py-0.5 rounded font-mono">⌘</kbd>
        <kbd class="text-xs bg-surface1 text-overlay2 px-1 py-0.5 rounded font-mono">K</kbd>
      </span>
    </button>

    <!-- Login / User -->
    <LoginModal client:load />
  </div>

  <!-- Mobile right: search + login -->
  <div class="lg:hidden flex items-center gap-2">
    <button
      id="open-palette-btn-mobile"
      class="p-1.5 rounded-lg text-subtext1 hover:text-text hover:bg-surface0 transition-colors"
      aria-label="Buscar"
    >
      <svg class="w-4.5 h-4.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
        <circle cx="11" cy="11" r="8"/>
        <line x1="21" y1="21" x2="16.65" y2="16.65"/>
      </svg>
    </button>
    <LoginModal client:load />
  </div>
</header>

<script>
  // Open command palette
  document.getElementById('open-palette-btn')?.addEventListener('click', () => {
    window.dispatchEvent(new CustomEvent('open-command-palette'));
  });
  document.getElementById('open-palette-btn-mobile')?.addEventListener('click', () => {
    window.dispatchEvent(new CustomEvent('open-command-palette'));
  });

  // Roadmap tabs
  document.querySelectorAll<HTMLButtonElement>('.road-tab').forEach((btn) => {
    btn.addEventListener('click', () => {
      const tab = btn.dataset.tab;
      // Update tab buttons
      document.querySelectorAll('.road-tab').forEach((t) => t.classList.remove('road-tab-active'));
      btn.classList.add('road-tab-active');
      // Show/hide panels
      document.querySelectorAll<HTMLElement>('.road-panel').forEach((panel) => {
        panel.classList.toggle('hidden', panel.dataset.panel !== tab);
      });
    });
  });

</script>

<style>
  .road-tab {
    color: theme('colors.subtext1');
  }
  .road-tab:hover {
    color: theme('colors.text');
    background-color: theme('colors.surface0');
  }
  .road-tab-active {
    color: theme('colors.text');
    border-bottom: 2px solid theme('colors.blue');
  }
</style>
