---
---

<footer class="border-t border-surface0 bg-mantle/50 px-6 py-8 mt-16">
  <div class="max-w-content mx-auto">
    <div class="flex flex-col md:flex-row items-center justify-between gap-4">
      <div class="flex items-center gap-2">
        <img src="/devpiece-logo.png" alt="" class="w-9 h-9 object-contain" />
        <span class="font-semibold text-text text-sm">DevPiece</span>
        <span class="text-subtext1 text-sm">— Tu arsenal dev definitivo</span>
      </div>

      <div class="flex items-center gap-6 text-sm text-subtext1">
        <a
          href="https://github.com/mkcodev/dev-piece"
          target="_blank"
          rel="noopener noreferrer"
          class="hover:text-text transition-colors"
          id="contribuir"
        >
          Contribuir
        </a>
        <a href="/sitemap-index.xml" class="hover:text-text transition-colors">
          Sitemap
        </a>
        <span>
          Hecho con
          <span class="text-red" aria-label="amor">♥</span>
          para la comunidad dev
        </span>
      </div>
    </div>

    <div class="mt-6 pt-6 border-t border-surface0/50 flex flex-col sm:flex-row items-center justify-between gap-2 text-xs text-overlay2">
      <p>
        DevPiece es un proyecto open-source. Añade nuevas herramientas creando un archivo
        <code class="bg-surface0 px-1 py-0.5 rounded">.mdx</code> en la carpeta de la categoría correspondiente.
      </p>
      <p class="flex-shrink-0">
        by
        <a
          href="https://github.com/mkcodev"
          target="_blank"
          rel="noopener noreferrer"
          class="text-subtext1 hover:text-text transition-colors font-medium ml-0.5"
        >
          mkcodev
        </a>
      </p>
    </div>
  </div>
</footer>
