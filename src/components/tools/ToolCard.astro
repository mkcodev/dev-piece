---
import InstallMenu from './InstallMenu';
import Icon from '../common/Icon.astro';
import { toolIconSvg } from '../../lib/tool-icons';

interface Props {
  name: string;
  description: string;
  tags: string[];
  os: string[];
  category: string;
  slug: string;
  featured?: boolean;
  difficulty?: 'beginner' | 'intermediate' | 'advanced';
  install?: Record<string, string | undefined>;
  links?: { repo?: string; docs?: string; website?: string; video?: string };
  accent?: string;
}

const {
  name,
  description,
  tags,
  os,
  category,
  slug,
  featured = false,
  difficulty,
  install,
  links,
  accent = '#8caaee',
} = Astro.props;

const href = `/${category}/${slug}`;

const installEntries = install ? Object.entries(install).filter(([, v]) => v) : [];

const difficultyConfig = {
  beginner:     { label: 'Principiante', color: 'bg-green',  title: 'Nivel: Principiante' },
  intermediate: { label: 'Intermedio',   color: 'bg-yellow', title: 'Nivel: Intermedio' },
  advanced:     { label: 'Avanzado',     color: 'bg-red',    title: 'Nivel: Avanzado' },
};

const osBadgeConfig: Record<string, { label: string; color: string }> = {
  windows: { label: 'Win',   color: 'chip chip-blue' },
  macos:   { label: 'Mac',   color: 'chip chip-mauve' },
  linux:   { label: 'Linux', color: 'chip chip-peach' },
  cross:   { label: 'Cross', color: 'chip chip-green' },
};

// Primary outbound link: repository first, then website, then docs
const outbound = links?.repo
  ? { href: links.repo, label: 'Repo', icon: 'github', aria: `Repo de ${name} (pestaña nueva)` }
  : links?.website
    ? { href: links.website, label: 'Web', icon: 'globe', aria: `Web de ${name} (pestaña nueva)` }
    : links?.docs
      ? { href: links.docs, label: 'Docs', icon: 'book-open', aria: `Docs de ${name} (pestaña nueva)` }
      : null;
const iconSvg = toolIconSvg(slug, category);
---

<article
  class="tool-card reveal group relative bg-surface0 rounded-xl border border-surface1 flex flex-col overflow-hidden"
  style={`--card-accent: ${accent};`}
  data-fav-slug={slug}
  data-fav-cat={category}
  data-fav-name={name}
  data-fav-desc={description}
  data-fav-tags={JSON.stringify(tags)}
  data-fav-os={JSON.stringify(os)}
  data-fav-accent={accent}
  data-fav-difficulty={difficulty ?? ''}
  data-fav-install={JSON.stringify(Object.fromEntries(installEntries))}
>
  <!-- Featured top bar (permanent gradient) -->
  {featured ? (
    <div class="card-featured-bar" aria-hidden="true" />
  ) : (
    <!-- Hover accent bar (slides in on hover) -->
    <div class="card-accent-bar" aria-hidden="true" />
  )}

  <div class="relative z-10 p-4 flex flex-col gap-3 flex-1">
    <!-- Header row -->
    <div class="flex items-start justify-between gap-2">
      <div class="flex items-center gap-2.5 min-w-0">
        <!-- Icon — morphing target: card-icon-wrap -->
        <div
          class="card-icon-wrap w-8 h-8 rounded-lg flex items-center justify-center flex-shrink-0 overflow-hidden"
          style={`background-color: ${accent}20;`}
          aria-hidden="true"
        >
          <span style={`color: ${accent};`} set:html={iconSvg} />
        </div>
        <!-- Title — morphing target: card-title-el -->
        <h3 class="card-title-el font-semibold text-text text-base leading-tight truncate">{name}</h3>
        <!-- EN USO badge (shown via JS when integrated) -->
        <span class="js-in-use-badge hidden text-[10px] font-bold px-1.5 py-0.5 rounded border flex-shrink-0" style="background:rgba(229,200,144,0.15);border-color:rgba(229,200,144,0.35);color:#e5c890;">EN USO</span>
        <!-- ALTERNATIVA badge (shown via JS when another tool in same category is integrated) -->
        <span class="js-alt-badge hidden text-[10px] font-bold px-1.5 py-0.5 rounded border flex-shrink-0" style="background:rgba(239,159,118,0.15);border-color:rgba(239,159,118,0.35);color:#ef9f76;">ALTERNATIVA</span>
      </div>

      <div class="flex items-center gap-1.5 flex-shrink-0">
        <div class="flex gap-1">
          {os.slice(0, 3).map((o) => {
            const cfg = osBadgeConfig[o];
            return cfg ? (
              <span class={`text-xs px-1.5 py-0.5 rounded border font-mono leading-none ${cfg.color}`}>
                {cfg.label}
              </span>
            ) : null;
          })}
        </div>
        {difficulty && (
          <span
            class={`w-2.5 h-2.5 rounded-full flex-shrink-0 ${difficultyConfig[difficulty].color}`}
            title={difficultyConfig[difficulty].title}
            role="img"
            aria-label={difficultyConfig[difficulty].title}
          />
        )}
      </div>
    </div>

    {installEntries.length > 0 && (
      <InstallMenu client:visible name={name} install={Object.fromEntries(installEntries)} accent={accent} />
    )}

    <!-- Description -->
    <p class="text-sm text-subtext1 line-clamp-2 leading-relaxed flex-1">
      {description}
    </p>

    <!-- Tags -->
    {tags.length > 0 && (
      <div class="flex flex-wrap gap-1 overflow-hidden max-h-6">
        {tags.slice(0, 5).map((tag) => (
          <span class="text-xs px-2 py-0.5 rounded-full bg-crust/50 text-subtext1 border border-surface1 flex-shrink-0">
            #{tag}
          </span>
        ))}
      </div>
    )}

    <!-- Footer: install + favorite + link -->
    <div class="flex items-center justify-between gap-2 pt-1 border-t border-surface1/50">
      {outbound ? (
        <a
          href={outbound.href}
          target="_blank"
          rel="noopener noreferrer"
          aria-label={outbound.aria}
          class="inline-flex items-center gap-1.5 min-h-7 -ml-1.5 px-1.5 rounded-md text-xs text-subtext1 transition-colors hover:text-text hover:bg-crust/50"
        >
          {outbound.icon === 'github' ? (
            <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0 0 24 12c0-6.63-5.37-12-12-12z"/></svg>
          ) : (
            <Icon name={outbound.icon} class="w-3.5 h-3.5" />
          )}
          {outbound.label}
        </a>
      ) : <span />}

      <div class="flex items-center gap-2 flex-shrink-0">
        <button
          class="js-alt-btn inline-flex items-center justify-center w-7 h-7 rounded-md hover:bg-crust/50 text-subtext1 hover:text-peach transition-colors"
          aria-label={`Marcar ${name} como alternativa conocida`}
          title="Marcar como alternativa"
        >
          <svg class="w-4 h-4 js-alt-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7h12m0 0l-4-4m4 4l-4 4m0 6H4m0 0l4 4m-4-4l4-4"/>
          </svg>
        </button>
        <button
          class="js-int-btn inline-flex items-center justify-center w-7 h-7 rounded-md hover:bg-crust/50 text-subtext1 hover:text-yellow transition-colors"
          aria-label={`Marcar ${name} como integrado`}
          title="Marcar como integrado"
        >
          <svg class="w-4 h-4 js-int-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/>
          </svg>
        </button>
        <button
          class="js-fav-btn inline-flex items-center justify-center w-7 h-7 rounded-md hover:bg-crust/50 text-subtext1 hover:text-red transition-colors"
          aria-label={`Añadir ${name} a favoritos`}
          title="Añadir a favoritos"
        >
          <svg class="w-4 h-4 js-fav-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7l-1.318-1.318a4.5 4.5 0 00-6.364 0z"/>
          </svg>
        </button>
        <a
          href={href}
          class="text-xs text-lavender hover:text-text font-medium transition-colors flex items-center gap-1"
        >
          Ver más
          <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m9 18 6-6-6-6"/>
          </svg>
        </a>
      </div>
    </div>
  </div>
</article>

<script>
  /* ---- Favorites ---- */
  const FAV_KEY = 'devpiece-favorites';

  function getFavs(): Array<Record<string, unknown>> {
    try { return JSON.parse(localStorage.getItem(FAV_KEY) ?? '[]'); } catch { return []; }
  }

  function isFav(slug: string, cat: string) {
    return getFavs().some((f) => f.slug === slug && f.category === cat);
  }

  function syncFavBtn(btn: HTMLButtonElement) {
    const article = btn.closest('article') as HTMLElement | null;
    if (!article) return;
    const slug = article.dataset.favSlug ?? '';
    const cat  = article.dataset.favCat  ?? '';
    const active = isFav(slug, cat);
    const icon = btn.querySelector('svg');
    if (icon) icon.setAttribute('fill', active ? 'currentColor' : 'none');
    btn.classList.toggle('text-red',      active);
    btn.classList.toggle('text-subtext1', !active);
    btn.setAttribute('aria-label', active ? 'Quitar de favoritos' : 'Añadir a favoritos');
  }

  function initFavBtns() {
    document.querySelectorAll<HTMLButtonElement>('.js-fav-btn').forEach((btn) => {
      if (btn.dataset.favInit) return;
      btn.dataset.favInit = '1';
      syncFavBtn(btn);
      btn.addEventListener('click', (e) => {
        e.preventDefault();
        e.stopPropagation();
        const article = btn.closest('article') as HTMLElement | null;
        if (!article) return;
        const { favSlug: slug, favCat: cat, favName: name, favDesc: description,
                favTags, favOs, favAccent: accent, favDifficulty: difficulty } = article.dataset;
        if (!slug || !cat) return;
        let favs = getFavs();
        if (isFav(slug, cat)) {
          favs = favs.filter((f) => !(f.slug === slug && f.category === cat));
        } else {
          favs.unshift({ slug, category: cat, name, description,
            tags: JSON.parse(favTags ?? '[]'),
            os:   JSON.parse(favOs   ?? '[]'),
            accent, difficulty });
        }
        localStorage.setItem(FAV_KEY, JSON.stringify(favs));
        window.dispatchEvent(new CustomEvent('favorites-updated'));
        /* Heart pulse */
        btn.classList.add('fav-btn-active');
        btn.addEventListener('animationend', () => btn.classList.remove('fav-btn-active'), { once: true });
        syncFavBtn(btn);
      });
    });
  }

  initFavBtns();
  document.addEventListener('astro:page-load', initFavBtns);

  /* ---- Integrations ---- */
  const INT_KEY = 'devpiece-integrations';

  function getInts(): Array<Record<string, unknown>> {
    try { return JSON.parse(localStorage.getItem(INT_KEY) ?? '[]'); } catch { return []; }
  }
  function isInt(slug: string, cat: string) {
    return getInts().some((i) => i.slug === slug && i.category === cat);
  }
  function syncIntBtn(btn: HTMLButtonElement) {
    const article = btn.closest('article') as HTMLElement | null;
    if (!article) return;
    const slug = article.dataset.favSlug ?? '';
    const cat  = article.dataset.favCat  ?? '';
    const active = isInt(slug, cat);
    const icon = btn.querySelector('svg');
    if (icon) icon.setAttribute('fill', active ? 'currentColor' : 'none');
    btn.classList.toggle('text-yellow',   active);
    btn.classList.toggle('text-subtext1', !active);
    btn.setAttribute('aria-label', active ? 'Quitar integración' : 'Marcar como integrado');
    /* EN USO badge */
    const badge = article.querySelector<HTMLElement>('.js-in-use-badge');
    if (badge) badge.classList.toggle('hidden', !active);
  }
  function initIntBtns() {
    document.querySelectorAll<HTMLButtonElement>('.js-int-btn').forEach((btn) => {
      if (btn.dataset.intInit) return;
      btn.dataset.intInit = '1';
      syncIntBtn(btn);
      btn.addEventListener('click', (e) => {
        e.preventDefault(); e.stopPropagation();
        const article = btn.closest('article') as HTMLElement | null;
        if (!article) return;
        const { favSlug: slug, favCat: cat, favName: name, favDesc: description,
                favTags, favOs, favAccent: accent, favDifficulty: difficulty, favInstall } = article.dataset;
        if (!slug || !cat) return;
        let ints = getInts();
        if (isInt(slug, cat)) {
          ints = ints.filter((i) => !(i.slug === slug && i.category === cat));
        } else {
          const rawInstall = JSON.parse(favInstall ?? '{}');
          ints.unshift({ slug, category: cat, name, description,
            tags: JSON.parse(favTags ?? '[]'), os: JSON.parse(favOs ?? '[]'),
            accent, difficulty, install: rawInstall });
        }
        localStorage.setItem(INT_KEY, JSON.stringify(ints));
        window.dispatchEvent(new CustomEvent('integrations-updated'));
        syncIntBtn(btn);
      });
    });
  }
  initIntBtns();
  document.addEventListener('astro:page-load', initIntBtns);

  /* ---- Alternatives ---- */
  const ALT_KEY = 'devpiece-alternatives';

  function getAlts(): Array<Record<string, unknown>> {
    try { return JSON.parse(localStorage.getItem(ALT_KEY) ?? '[]'); } catch { return []; }
  }
  function isAlt(slug: string, cat: string) {
    return getAlts().some((a) => a.slug === slug && a.category === cat);
  }

  function syncAltBadges() {
    const ints = getInts();
    const intCats = new Set(ints.map((i) => i.category));
    const intKeys = new Set(ints.map((i) => `${i.category}/${i.slug}`));
    document.querySelectorAll<HTMLElement>('article[data-fav-cat]').forEach((article) => {
      const cat  = article.dataset.favCat  ?? '';
      const slug = article.dataset.favSlug ?? '';
      const altBadge   = article.querySelector<HTMLElement>('.js-alt-badge');
      const inUseBadge = article.querySelector<HTMLElement>('.js-in-use-badge');
      const isIntegrated = intKeys.has(`${cat}/${slug}`);
      const catHasInt    = intCats.has(cat);
      if (altBadge)   altBadge.classList.toggle('hidden',   !(catHasInt && !isIntegrated));
      if (inUseBadge) inUseBadge.classList.toggle('hidden',  !isIntegrated);
      // Highlight active (integrated) tool with accent ring
      article.classList.toggle('ring-1', isIntegrated);
      article.classList.toggle('ring-yellow/30', isIntegrated);
    });
  }

  function syncAltBtn(btn: HTMLButtonElement) {
    const article = btn.closest('article') as HTMLElement | null;
    if (!article) return;
    const slug = article.dataset.favSlug ?? '';
    const cat  = article.dataset.favCat  ?? '';
    const active = isAlt(slug, cat);
    btn.classList.toggle('text-peach', active);
    btn.classList.toggle('text-subtext1', !active);
    btn.setAttribute('aria-label', active ? 'Quitar alternativa' : 'Marcar como alternativa conocida');
    btn.setAttribute('title', active ? 'Quitar alternativa' : 'Marcar como alternativa');
  }

  function initAltBtns() {
    document.querySelectorAll<HTMLButtonElement>('.js-alt-btn').forEach((btn) => {
      if (btn.dataset.altInit) return;
      btn.dataset.altInit = '1';
      syncAltBtn(btn);
      btn.addEventListener('click', (e) => {
        e.preventDefault(); e.stopPropagation();
        const article = btn.closest('article') as HTMLElement | null;
        if (!article) return;
        const { favSlug: slug, favCat: cat, favName: name, favDesc: description,
                favTags, favOs, favAccent: accent, favDifficulty: difficulty } = article.dataset;
        if (!slug || !cat) return;
        let alts = getAlts();
        if (isAlt(slug, cat)) {
          alts = alts.filter((a) => !(a.slug === slug && a.category === cat));
        } else {
          alts.unshift({ slug, category: cat, name, description,
            tags: JSON.parse(favTags ?? '[]'), os: JSON.parse(favOs ?? '[]'),
            accent, difficulty });
        }
        localStorage.setItem(ALT_KEY, JSON.stringify(alts));
        window.dispatchEvent(new CustomEvent('alternatives-updated'));
        syncAltBtn(btn);
      });
    });
  }

  initAltBtns();
  syncAltBadges();
  document.addEventListener('astro:page-load', () => { initAltBtns(); syncAltBadges(); });
  window.addEventListener('integrations-updated', syncAltBadges);
  window.addEventListener('alternatives-updated', () => {
    document.querySelectorAll<HTMLButtonElement>('.js-alt-btn').forEach(syncAltBtn);
  });

</script>
