---
interface Props {
  name: string;
  description: string;
  tags: string[];
  os: string[];
  category: string;
  slug: string;
  featured?: boolean;
  difficulty?: 'beginner' | 'intermediate' | 'advanced';
  install?: Record<string, string | undefined>;
  accent?: string;
}

const {
  name,
  description,
  tags,
  os,
  category,
  slug,
  featured = false,
  difficulty,
  install,
  accent = '#8caaee',
} = Astro.props;

const href = `/${category}/${slug}`;

// Get best install command for display
const installEntries = install ? Object.entries(install).filter(([, v]) => v) : [];
const firstInstall = installEntries[0];

const difficultyConfig = {
  beginner: { label: 'Principiante', color: 'bg-green', title: 'Nivel: Principiante' },
  intermediate: { label: 'Intermedio', color: 'bg-yellow', title: 'Nivel: Intermedio' },
  advanced: { label: 'Avanzado', color: 'bg-red', title: 'Nivel: Avanzado' },
};

const osBadgeConfig: Record<string, { label: string; color: string }> = {
  windows: { label: 'Win', color: 'bg-blue/20 text-blue border-blue/30' },
  macos: { label: 'Mac', color: 'bg-mauve/20 text-mauve border-mauve/30' },
  linux: { label: 'Linux', color: 'bg-peach/20 text-peach border-peach/30' },
  cross: { label: 'Cross', color: 'bg-green/20 text-green border-green/30' },
};
---

<article
  class="group relative bg-surface0 rounded-xl border border-surface1 hover:border-lavender/40 card-glow transition-all duration-200 flex flex-col overflow-hidden animate-fade-in"
>
  {featured && (
    <div class="absolute top-0 left-0 right-0 h-0.5 bg-gradient-to-r from-blue via-lavender to-mauve" aria-hidden="true" />
  )}

  <div class="p-4 flex flex-col gap-3 flex-1">
    <!-- Header row -->
    <div class="flex items-start justify-between gap-2">
      <div class="flex items-center gap-2.5 min-w-0">
        <div
          class="w-8 h-8 rounded-lg flex items-center justify-center text-crust font-bold text-sm flex-shrink-0"
          style={`background-color: ${accent}30; color: ${accent};`}
          aria-hidden="true"
        >
          {name.charAt(0).toUpperCase()}
        </div>
        <h3 class="font-semibold text-text text-base leading-tight truncate">{name}</h3>
      </div>

      <div class="flex items-center gap-1.5 flex-shrink-0">
        <!-- OS badges -->
        <div class="flex gap-1">
          {os.slice(0, 3).map((o) => {
            const cfg = osBadgeConfig[o];
            return cfg ? (
              <span class={`text-xs px-1.5 py-0.5 rounded border font-mono leading-none ${cfg.color}`}>
                {cfg.label}
              </span>
            ) : null;
          })}
        </div>

        <!-- Difficulty dot -->
        {difficulty && (
          <span
            class={`w-2.5 h-2.5 rounded-full flex-shrink-0 ${difficultyConfig[difficulty].color}`}
            title={difficultyConfig[difficulty].title}
            role="img"
            aria-label={difficultyConfig[difficulty].title}
          />
        )}
      </div>
    </div>

    <!-- Description -->
    <p class="text-sm text-subtext1 line-clamp-2 leading-relaxed flex-1">
      {description}
    </p>

    <!-- Tags -->
    {tags.length > 0 && (
      <div class="flex flex-wrap gap-1 overflow-hidden max-h-6">
        {tags.slice(0, 5).map((tag) => (
          <span class="text-xs px-2 py-0.5 rounded-full bg-surface1 text-subtext0 border border-surface1 flex-shrink-0">
            #{tag}
          </span>
        ))}
      </div>
    )}

    <!-- Install command + link -->
    <div class="flex items-center justify-between gap-2 pt-1 border-t border-surface1/50">
      {firstInstall ? (
        <code class="text-xs text-sky bg-crust/50 px-2 py-1 rounded font-mono truncate max-w-[60%]">
          {firstInstall[1]}
        </code>
      ) : (
        <span />
      )}
      <a
        href={href}
        class="text-xs text-blue hover:text-lavender font-medium transition-colors flex items-center gap-1 flex-shrink-0"
      >
        Ver más
        <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m9 18 6-6-6-6"/>
        </svg>
      </a>
    </div>
  </div>
</article>
