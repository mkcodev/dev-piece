---
import CopyButton from '../common/CopyButton';

interface Props {
  code: string;
  lang?: string;
  label?: string;
  description?: string;
  showLineNumbers?: boolean;
}

const { code, lang = 'bash', label, description, showLineNumbers = false } = Astro.props;

const langLabels: Record<string, string> = {
  bash: 'Bash',
  shell: 'Shell',
  powershell: 'PowerShell',
  ps1: 'PowerShell',
  json: 'JSON',
  toml: 'TOML',
  yaml: 'YAML',
  yml: 'YAML',
  lua: 'Lua',
  typescript: 'TypeScript',
  ts: 'TypeScript',
  javascript: 'JavaScript',
  js: 'JavaScript',
  vim: 'Vim',
  viml: 'VimL',
  ini: 'INI',
  text: 'TEXT',
};

const langLabel = langLabels[lang] ?? lang.toUpperCase();
---

<div class="group relative my-4">
  {(label || description) && (
    <div class="mb-2">
      {label && <span class="text-sm font-medium text-text">{label}</span>}
      {description && <p class="text-xs text-subtext1 mt-0.5">{description}</p>}
    </div>
  )}

  <div class="relative">
    <!-- Language badge + copy button -->
    <div class="flex items-center justify-between px-4 py-2 bg-crust rounded-t-lg border border-surface0 border-b-0">
      <span class="text-xs font-mono text-subtext1 font-medium">{langLabel}</span>
      <CopyButton client:visible text={code} label="Copiar" />
    </div>

    <!-- Code block -->
    <div class="relative bg-crust border border-surface0 rounded-b-lg overflow-x-auto">
      <pre
        class:list={[
          "p-4 text-sm font-mono leading-relaxed overflow-x-auto",
          showLineNumbers && "line-numbers"
        ]}
        data-language={lang}
      ><code class={`language-${lang} text-text`}>{code}</code></pre>
    </div>
  </div>
</div>
